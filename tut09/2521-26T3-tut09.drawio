        <mxCell id="59Bdmfl4Ggd1Ja2baNV9-85" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Design a hash &lt;font&gt;h&lt;sub&gt;2&lt;/sub&gt;(x)&lt;/font&gt;&lt;font&gt; that&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;maps x into &lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;h&lt;sub&gt;2&lt;/sub&gt;(x)&lt;/font&gt;&lt;font&gt; &lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;range [1 ... N-1]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="220" x="1340" y="4995" as="geometry" />
        </mxCell>
        <mxCell id="59Bdmfl4Ggd1Ja2baNV9-86" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Design a hash &lt;font&gt;h&lt;sub&gt;2&lt;/sub&gt;(x)&lt;/font&gt;&lt;font&gt; that&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;maps x into &lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;h&lt;sub&gt;2&lt;/sub&gt;(x)&lt;/font&gt;&lt;font&gt; &lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;range [1... N-1]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;x % N &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&amp;nbsp; in range &lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;[0..N-1]&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;x % (N-1) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; in range &lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;[0..N-2] &lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;x % (N-1) + 1 &amp;nbsp;&amp;nbsp; in range &lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;[1.. N-1]&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;Final:&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;h&lt;sub&gt;2&lt;/sub&gt;(x) = x % (N-1) + 1&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="210" x="2250" y="4975" as="geometry" />
        </mxCell>
