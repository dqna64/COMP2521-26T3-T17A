        <mxCell id="59Bdmfl4Ggd1Ja2baNV9-76" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#4D4D4D;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;This average case assumes clusters are small. In reality, as more items are added,  clusters will get larger, therefore worsening the time complexity of insertion when hash collision occurs.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="190.5" x="2269.5" y="1710" as="geometry" />
        </mxCell>
        <mxCell id="59Bdmfl4Ggd1Ja2baNV9-77" edge="1" parent="1" source="59Bdmfl4Ggd1Ja2baNV9-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;dashed=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry">
