        <mxCell id="59Bdmfl4Ggd1Ja2baNV9-78" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#4D4D4D;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;With double hashing: as more items are added, large clusters won&#39;t form as easily as in linear probing. Hence time complexity of insertion won&#39;t worsen as quickly.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="190.5" x="2274.5" y="1920" as="geometry" />
        </mxCell>
